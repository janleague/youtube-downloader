{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube İndirici",
  "version": "2.2.6",
  "identifier": "com.janleague.youtube-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube İndirici",
        "width": 1180,
        "height": 752,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["binaries/backend/"],
    "icon": ["../../../app_icon.ico", "../../../app_icon.png"],
    "windows": {
      "nsis": {
        "installerIcon": "../../../app_icon.ico",
        "uninstallerIcon": "../../../app_icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NEQzNTlGNjI2ODNERkIKUldUN1BXaGluelZOZGVxNTIwV3ZId3BqUFMvS0hNYkRCd3RrT1BYeHZtelFpOGlMUk9uNDU3dVYK",
      "endpoints": [
        "https://github.com/janleague/youtube-downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
