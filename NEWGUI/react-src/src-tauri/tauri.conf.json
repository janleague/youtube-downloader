{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube İndirici",
  "version": "2.2.0",
  "identifier": "com.janleague.youtube-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube İndirici",
        "width": 1180,
        "height": 752,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/youtube-downloader-backend"],
    "icon": ["../../../app_icon.ico", "../../../app_icon.png"]
  }
}
